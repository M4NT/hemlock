# Hemlock — environment variables
# Copy to .env and fill in the keys you need.

# ── LLM providers (at least one required for hemlock run/score) ──────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_HOST=http://localhost:11434  # default; override if Ollama runs elsewhere

# ── Optional: override default ChromaDB persist directory ─────────────────────
# HEMLOCK_PERSIST_DIR=.hemlock/chroma

# ── Optional: default model (overridden by --model flag) ─────────────────────
# HEMLOCK_MODEL=claude-haiku-4-5-20251001
