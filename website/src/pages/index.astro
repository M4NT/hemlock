---
import Base from "../layouts/Base.astro";
import TerminalCard from "../components/TerminalCard.astro";
import { PORTFOLIO } from "@hemlock/mcp/data";

const curlExample = [
  `curl https://hemlock.dev/api/mcp \\`,
  `  -H "Content-Type: application/json" \\`,
  `  -d '{"jsonrpc":"2.0","method":"tools/call",`,
  `       "params":{"name":"get_context","arguments":{}}}'`,
];

const toolList = [
  `tools/list → [`,
  `  get_context   // who this is`,
  `  get_resume    // full CV as JSON`,
  `  list_projects // open-source work`,
  `  get_skills    // tech stack breakdown`,
  `  book_intro    // schedule a conversation`,
  `]`,
];
---

<Base>
  <main>

    <!-- ── Identity ─────────────────────────────── -->
    <section class="identity">
      <div class="prompt-line">
        <span class="prompt">~</span>
        <span class="cursor" aria-hidden="true"/>
      </div>
      <h1>{PORTFOLIO.name}</h1>
      <p class="title">{PORTFOLIO.title}</p>
      <p class="bio">{PORTFOLIO.bio}</p>

      <div class="meta-row">
        <span class="chip">{PORTFOLIO.location}</span>
        <a class="chip chip-link" href={PORTFOLIO.github}>github</a>
        <a class="chip chip-link" href="/llms.txt">llms.txt</a>
        <a class="chip chip-link" href="/AGENTS.md">AGENTS.md</a>
      </div>
    </section>

    <!-- ── Machine layer ─────────────────────────── -->
    <section class="block">
      <h2 class="section-label">// agent interface</h2>
      <TerminalCard label="curl · MCP endpoint" lines={curlExample} highlight={[0]} />
      <div class="gap-sm"/>
      <TerminalCard label="tools/list" lines={toolList} highlight={[0, 6]} />
      <p class="hint">
        Any MCP-compatible client can connect to
        <code>https://hemlock.dev/api/mcp</code> and call these tools directly.
      </p>
    </section>

    <!-- ── Skills ────────────────────────────────── -->
    <section class="block">
      <h2 class="section-label">// skills</h2>
      <div class="skill-grid">
        {Object.entries(PORTFOLIO.skills).map(([cat, items]) => (
          <div class="skill-group">
            <span class="skill-cat">{cat}</span>
            <div class="skill-items">
              {items.map((s) => <span class="skill-pill">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Projects ──────────────────────────────── -->
    <section class="block">
      <h2 class="section-label">// projects</h2>
      {PORTFOLIO.projects.map((p) => (
        <a class="project-card" href={p.url} target="_blank" rel="noopener">
          <div class="project-name">{p.name}</div>
          <div class="project-desc">{p.description}</div>
          <div class="project-tags">
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </a>
      ))}
    </section>

    <!-- ── Availability ──────────────────────────── -->
    <section class="block availability">
      <h2 class="section-label">// availability</h2>
      <p>{PORTFOLIO.availability}</p>
      <a class="cta" href={`mailto:${PORTFOLIO.email}`}>
        {PORTFOLIO.email}
        <span class="cta-arrow">→</span>
      </a>
    </section>

    <!-- ── Footer ────────────────────────────────── -->
    <footer>
      <span>hemlock.dev</span>
      <span class="sep">·</span>
      <a href="/api/mcp">/api/mcp</a>
      <span class="sep">·</span>
      <a href="/llms.txt">llms.txt</a>
      <span class="sep">·</span>
      <a href="https://github.com/M4NT/hemlock">source</a>
    </footer>

  </main>
</Base>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 80px 24px 100px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* Identity */
  .identity { display: flex; flex-direction: column; gap: 12px; }

  .prompt-line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .prompt {
    color: var(--green);
    font-size: 13px;
    opacity: 0.6;
  }

  .cursor {
    width: 9px;
    height: 16px;
    background: var(--green);
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  h1 {
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .title {
    font-size: 13px;
    color: var(--green);
    letter-spacing: 0.03em;
  }

  .bio {
    font-size: 14px;
    color: var(--text);
    line-height: 1.7;
    max-width: 560px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .chip {
    font-size: 11.5px;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--muted);
  }

  .chip-link { color: var(--green-dim); border-color: var(--green-dim); }
  .chip-link:hover { color: var(--green); border-color: var(--green); text-decoration: none; }

  /* Sections */
  .block { display: flex; flex-direction: column; gap: 14px; }

  .section-label {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.08em;
    font-weight: 400;
  }

  .gap-sm { height: 4px; }

  .hint {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.6;
  }

  .hint code {
    color: var(--green-dim);
    font-size: 11.5px;
  }

  /* Skills */
  .skill-grid { display: flex; flex-direction: column; gap: 10px; }

  .skill-group { display: flex; align-items: flex-start; gap: 12px; }

  .skill-cat {
    font-size: 11px;
    color: var(--muted);
    min-width: 64px;
    padding-top: 3px;
    letter-spacing: 0.04em;
  }

  .skill-items { display: flex; flex-wrap: wrap; gap: 6px; }

  .skill-pill {
    font-size: 12px;
    padding: 2px 9px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
  }

  /* Projects */
  .project-card {
    display: block;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    transition: border-color 0.15s;
  }

  .project-card:hover {
    border-color: var(--green-dim);
    text-decoration: none;
  }

  .project-name {
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 4px;
  }

  .project-desc {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 10px;
  }

  .project-tags { display: flex; flex-wrap: wrap; gap: 5px; }

  .tag {
    font-size: 10.5px;
    padding: 1px 7px;
    border-radius: 3px;
    background: var(--dim);
    color: var(--muted);
    border: 1px solid var(--border);
  }

  /* Availability */
  .availability { gap: 10px; }
  .availability p { font-size: 13.5px; color: var(--text); }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--green);
    padding: 8px 0;
    border-bottom: 1px solid var(--green-dim);
    width: fit-content;
    transition: gap 0.15s;
  }

  .cta:hover { gap: 14px; text-decoration: none; }
  .cta-arrow { transition: transform 0.15s; }
  .cta:hover .cta-arrow { transform: translateX(4px); }

  /* Footer */
  footer {
    font-size: 11.5px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .sep { opacity: 0.3; }

  footer a { color: var(--muted); }
  footer a:hover { color: var(--green); text-decoration: none; }
</style>
